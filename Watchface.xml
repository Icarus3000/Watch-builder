<WatchFace width="450" height="450">
    <!-- Clean White Background -->
    <Scene backgroundColor="#FFFFFF">
        
        <!-- Minimalist Dial Index Markers -->
        <PartDraw x="0" y="0" width="450" height="450">
            <!-- 12 O'Clock -->
            <Line startX="225" startY="20" endX="225" endY="50">
                <Stroke color="#111111" thickness="8" cap="ROUND"/>
            </Line>
            <!-- 3 O'Clock -->
            <Line startX="430" startY="225" endX="400" endY="225">
                <Stroke color="#111111" thickness="8" cap="ROUND"/>
            </Line>
            <!-- 6 O'Clock -->
            <Line startX="225" startY="430" endX="225" endY="400">
                <Stroke color="#111111" thickness="8" cap="ROUND"/>
            </Line>
            <!-- 9 O'Clock -->
            <Line startX="20" startY="225" endX="50" endY="225">
                <Stroke color="#111111" thickness="8" cap="ROUND"/>
            </Line>
        </PartDraw>
        
        <!-- Hour Hand (Rotates 30 degrees per hour + 0.5 degrees per minute) -->
        <Group x="0" y="0" width="450" height="450" pivotX="225" pivotY="225">
            <Transform target="angle" value="([HOUR_0_11] * 30) + ([MINUTE] * 0.5)" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="225" startY="225" endX="225" endY="110">
                    <Stroke color="#000000" thickness="12" cap="ROUND"/>
                </Line>
            </PartDraw>
        </Group>
        
        <!-- Minute Hand (Rotates 6 degrees per minute + 0.1 degrees per second) -->
        <Group x="0" y="0" width="450" height="450" pivotX="225" pivotY="225">
            <Transform target="angle" value="([MINUTE] * 6) + ([SECOND] * 0.1)" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="225" startY="225" endX="225" endY="60">
                    <Stroke color="#333333" thickness="8" cap="ROUND"/>
                </Line>
            </PartDraw>
        </Group>
        
        <!-- Sweeping Second Hand (Oyster Perpetual continuous movement) -->
        <Group x="0" y="0" width="450" height="450" pivotX="225" pivotY="225">
            <!-- Binding rotation to milliseconds forces a seamless 60fps sweep -->
            <Transform target="angle" value="([SECOND] * 6) + ([MILLISECOND] * 0.006)" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="225" startY="260" endX="225" endY="50">
                    <Stroke color="#D40000" thickness="4" cap="ROUND"/>
                </Line>
            </PartDraw>
        </Group>
        
        <!-- Center Pin Overlay -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="215" y="215" width="20" height="20">
                <Fill color="#D40000"/>
            </Ellipse>
        </PartDraw>
        
    </Scene>
</WatchFace>
